"use client"

import { useEffect, useState } from "react"
import { db } from "@/lib/firebase"
import { collection, doc, onSnapshot, addDoc } from "firebase/firestore"

const PRECOS_PRODUTOS: { [key: string]: number } = {
  tapiocaMolhada: 8.00,
  tapiocaManteiga: 6.00,
  tapiocaQueijo: 8.00,
  cuscuzMilho: 5.00,
  cuscuzArroz: 6.00,
  cafe: 4.00
}

const DETALHES_PRODUTOS: { [key: string]: { nome: string; desc: string; icone: string } } = {
  tapiocaMolhada: { nome: "Tapioca Molhada", desc: "Tradicional com bastante leite de coco quentinho.", icone: "🥥" },
  tapiocaManteiga: { nome: "Tapioca com Manteiga", desc: "Derretida na goma quentinha, crocante por fora.", icone: "🧈" },
  tapiocaQueijo: { nome: "Tapioca com Queijo", desc: "Queijo coalho tostado direto na chapa.", icone: "🧀" },
  cuscuzMilho: { nome: "Cuscuz de Milho", desc: "Fofinho, feito no vapor na hora.", icone: "🌽" },
  cuscuzArroz: { nome: "Cuscuz de Arroz", desc: "Uma delícia tradicional e leve.", icone: "🍚" },
  cafe: { nome: "Café Quentinho", desc: "Passado na hora, o par perfeito para o seu cuscuz.", icone: "☕" }
}

const OPCOES_HORARIOS = [
  "06:00", "06:30", "07:00", "07:30", "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00"
]

export default function ClientePainel() {
  const [lojaAberta, setLojaAberta] = useState<boolean>(true)
  const [carregandoLoja, setCarregandoLoja] = useState(true)
  const [enviandoPedido, setEnviandoPedido] = useState(false)
  const [etapa, setEtapa] = useState<"menu" | "checkout">("menu")

  // Dados do Formulário do Cliente
  const [nome, setNome] = useState("")
  const [endereco, setEndereco] = useState("")
  const [pagamento, setPagamento] = useState<"Pix" | "Dinheiro">("Pix")
  const [trocoPara, setTrocoPara] = useState("")
  const [horario, setHorario] = useState("07:00")

  // Quantidades selecionadas
  const [itens, setItens] = useState<{ [key: string]: number }>({
    tapiocaMolhada: 0,
    tapiocaManteiga: 0,
    tapiocaQueijo: 0,
    cuscuzMilho: 0,
    cuscuzArroz: 0,
    cafe: 0,
  })

  // Escuta status de funcionamento em tempo real
  useEffect(() => {
    const refLoja = doc(db, "configuracoes", "loja")
    const unsubscribe = onSnapshot(refLoja, (snap) => {
      if (snap.exists()) {
        setLojaAberta(snap.data().aberta)
      }
      setCarregandoLoja(false)
    })
    return () => unsubscribe()
  }, [])

  function alterarQtd(chave: string, valor: number) {
    setItens(prev => ({
      ...prev,
      [chave]: Math.max(0, prev[chave] + valor)
    }))
  }

  // Cálculos matemáticos de subtotal e desconto de combos automáticos
  const totalItensSelecionados = Object.values(itens).reduce((a, b) => a + b, 0)
  
  let subtotal = 0
  let qtdComidas = 0
  let qtdCafes = itens.cafe

  Object.entries(itens).forEach(([key, qtd]) => {
    subtotal += (PRECOS_PRODUTOS[key] || 0) * qtd
    if (key !== "cafe") qtdComidas += qtd
  })

  let descontoCombo = 0
  if (qtdComidas > 0 && qtdCafes > 0) {
    const totalCombosPossiveis = Math.min(qtdComidas, qtdCafes)
    let cafesAplicados = 0

    Object.entries(itens).forEach(([key, qtd]) => {
      if (key !== "cafe" && qtd > 0) {
        const comidasNoCombo = Math.min(qtd, totalCombosPossiveis - cafesAplicados)
        if (comidasNoCombo > 0) {
          const valorNormalPar = PRECOS_PRODUTOS[key] + PRECOS_PRODUTOS.cafe
          const descontoPorPar = valorNormalPar - 10.00
          descontoCombo += descontoPorPar * comidasNoCombo
          cafesAplicados += comidasNoCombo
        }
      }
    })
  }

  const valorTotalFinal = Math.max(0, subtotal - descontoCombo)
  const trocoParaNum = parseFloat(trocoPara.replace(",", ".")) || 0
  const trocoCalculado = pagamento === "Dinheiro" && trocoParaNum > valorTotalFinal ? trocoParaNum - valorTotalFinal : 0

  async function finalizarPedidoCliente(e: any) {
    e.preventDefault()
    if (!nome.trim() || valorTotalFinal === 0 || !lojaAberta || enviandoPedido) return
    setEnviandoPedido(true)

    const payloadPedido = {
      nome: nome.trim(),
      endereco: endereco.trim() || "Retirada no Balcão",
      pagamento,
      troco: trocoCalculado,
      valorTotal: valorTotalFinal,
      horario,
      pago: pagamento === "Pix",
      concluido: false,
      dataCriacao: new Date().toISOString(),
      itens
    }

    try {
      await addDoc(collection(db, "pedidos"), payloadPedido)
      setItens({ tapiocaMolhada: 0, tapiocaManteiga: 0, tapiocaQueijo: 0, cuscuzMilho: 0, cuscuzArroz: 0, cafe: 0 })
      setNome("")
      setEndereco("")
      setTrocoPara("")
      setEtapa("menu")
      alert("🎉 Seu pedido foi enviado para a cozinha com sucesso!")
    } catch (error) {
      console.error(error)
      alert("Houve um erro ao processar o envio. Tente novamente.")
    } finally {
      setEnviandoPedido(false)
    }
  }

  if (carregandoLoja) {
    return (
      <div className="min-h-screen bg-zinc-950 flex items-center justify-center text-zinc-500 text-xs tracking-widest animate-pulse">
        CARREGANDO CARDÁPIO...
      </div>
    )
  }

  return (
    <main className="min-h-screen bg-zinc-950 text-zinc-100 pb-32 font-sans antialiased selection:bg-orange-500/30">
      
      <header className="sticky top-0 z-40 bg-zinc-950/80 backdrop-blur-md border-b border-zinc-900 px-4 py-4 transition-all">
        <div className="max-w-2xl mx-auto flex items-center justify-between">
          <div>
            <h1 className="text-lg font-black text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-500 tracking-tight">TAPICUZ ☀️</h1>
            <p className="text-[10px] text-zinc-500 font-bold uppercase tracking-wider">Café da Manhã Nordestino</p>
          </div>

          <div className={`px-3 py-1 rounded-full border text-[10px] font-black uppercase tracking-wide flex items-center gap-1.5 ${lojaAberta ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-400" : "bg-red-500/10 border-red-500/20 text-red-400"}`}>
            <span className={`w-1.5 h-1.5 rounded-full ${lojaAberta ? "bg-emerald-400 animate-ping" : "bg-red-400"}`} />
            {lojaAberta ? "Aberto para pedidos" : "Fechado"}
          </div>
        </div>
      </header>

      {!lojaAberta && etapa === "menu" && (
        <div className="max-w-md mx-auto mt-12 px-4 text-center space-y-3">
          <div className="text-4xl">🌙</div>
          <h2 className="text-sm font-black uppercase text-zinc-300">Ficamos felizes com sua visita!</h2>
          <p className="text-xs text-zinc-500 leading-relaxed">No momento não estamos aceitando novos pedidos pelo painel. Volte em breve para saborear o melhor café da manhã!</p>
        </div>
      )}

      {etapa === "menu" && (
        <div className="max-w-2xl mx-auto px-4 mt-6 space-y-6 animate-fade-in">
          <div className="bg-gradient-to-r from-orange-950/40 to-amber-950/40 border border-orange-500/20 rounded-3xl p-4 flex items-center gap-3">
            <span className="text-2xl">🔥</span>
            <div className="text-xs">
              <h4 className="font-black text-orange-400 uppercase tracking-wide">Combo Tradicional Ativo!</h4>
              <p className="text-zinc-400 font-medium">Monte qualquer par de <strong>Comida + Café</strong> por apenas <strong className="text-emerald-400 font-black">R$ 10,00</strong>. O desconto é calculado na hora!</p>
            </div>
          </div>

          <div className="space-y-3">
            {Object.keys(DETALHES_PRODUTOS).map((chave) => {
              const produto = DETALHES_PRODUTOS[chave]
              const preco = PRECOS_PRODUTOS[chave]
              const quantidade = itens[chave] || 0

              return (
                <div 
                  key={chave} 
                  className={`border rounded-3xl p-4 flex items-center justify-between gap-4 transition-all duration-300 bg-zinc-900/40 ${quantidade > 0 ? "border-orange-500/40 shadow-lg shadow-orange-500/5 bg-zinc-900/80" : "border-zinc-900"}`}
                >
                  <div className="flex-1 space-y-1">
                    <div className="flex items-center gap-2">
                      <span className="text-lg">{produto.icone}</span>
                      <h3 className="font-bold text-zinc-100 text-sm tracking-wide uppercase">{produto.nome}</h3>
                    </div>
                    <p className="text-xs text-zinc-500 font-medium max-w-sm">{produto.desc}</p>
                    <span className="text-emerald-400 font-black text-xs block pt-0.5">R$ {preco.toFixed(2)}</span>
                  </div>

                  {lojaAberta && (
                    <div className="flex items-center bg-zinc-950 border border-zinc-800/80 rounded-2xl p-1 gap-2 shadow-inner">
                      {quantidade > 0 ? (
                        <>
                          <button 
                            type="button" 
                            onClick={() => alterarQtd(chave, -1)} 
                            className="w-8 h-8 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-400 active:scale-90 font-black text-sm transition-all"
                          >
                            -
                          </button>
                          <span className="font-black text-zinc-100 text-xs w-4 text-center animate-fade-in">{quantidade}</span>
                        </>
                      ) : null}
                      <button 
                        type="button" 
                        onClick={() => alterarQtd(chave, 1)} 
                        className={`h-8 rounded-xl font-black text-xs transition-all active:scale-95 flex items-center justify-center ${quantidade > 0 ? "w-8 bg-orange-600 text-white shadow-md shadow-orange-600/20" : "px-4 bg-zinc-900 text-zinc-300 border border-zinc-800/50 hover:border-zinc-700"}`}
                      >
                        {quantidade > 0 ? "+" : "Adicionar"}
                      </button>
                    </div>
                  )}
                </div>
              )
            })}
          </div>
        </div>
      )}

      {etapa === "checkout" && (
        <div className="max-w-md mx-auto px-4 mt-6 space-y-6 animate-fade-in">
          <div className="flex items-center gap-2 border-b border-zinc-900 pb-3">
            <button onClick={() => setEtapa("menu")} className="text-zinc-500 hover:text-zinc-300 font-bold text-xs bg-zinc-900 px-3 py-1.5 rounded-xl">← Voltar</button>
            <h2 className="text-xs font-black uppercase text-orange-400 tracking-wider">Finalização do Pedido</h2>
          </div>

          <form onSubmit={finalizarPedidoCliente} className="space-y-4 text-xs">
            <div className="bg-zinc-900/40 border border-zinc-900 p-5 rounded-3xl space-y-4">
              <div>
                <label className="text-[10px] font-bold text-zinc-400 uppercase block mb-1">Seu Nome *</label>
                <input 
                  type="text" 
                  required 
                  placeholder="Ex: Maria Souza" 
                  value={nome} 
                  onChange={(e) => setNome(e.target.value)} 
                  className="w-full bg-zinc-950 border border-zinc-800 focus:border-orange-500 rounded-xl p-3 text-white outline-none font-medium" 
                />
              </div>

              <div>
                <label className="text-[10px] font-bold text-zinc-400 uppercase block mb-1">Endereço de Entrega (Deixe em branco para retirar)</label>
                <input 
                  type="text" 
                  placeholder="Ex: Rua das Flores, 123 - Centro" 
                  value={endereco} 
                  onChange={(e) => setEndereco(e.target.value)} 
                  className="w-full bg-zinc-950 border border-zinc-800 focus:border-orange-500 rounded-xl p-3 text-white outline-none font-medium" 
                />
              </div>

              <div>
                <label className="text-[10px] font-bold text-zinc-400 uppercase block mb-1">Horário Agendado / Estimado</label>
                <select 
                  value={horario} 
                  onChange={(e) => setHorario(e.target.value)} 
                  className="w-full bg-zinc-950 border border-zinc-800 focus:border-orange-500 rounded-xl p-3 text-white outline-none font-bold"
                >
                  {OPCOES_HORARIOS.map(hora => (
                    <option key={hora} value={hora}>⏱️ Retirar/Receber às {hora}</option>
                  ))}
                </select>
              </div>
            </div>

            <div className="bg-zinc-900/40 border border-zinc-900 p-5 rounded-3xl space-y-4">
              <div>
                <label className="text-[10px] font-bold text-zinc-400 uppercase block mb-1">Forma de Pagamento</label>
                <div className="grid grid-cols-2 gap-2">
                  <button 
                    type="button" 
                    onClick={() => setPagamento("Pix")}
                    className={`p-3 rounded-xl border font-black text-center uppercase tracking-wider transition-all ${pagamento === "Pix" ? "bg-teal-500/10 border-teal-500 text-teal-400" : "bg-zinc-950 border-zinc-800 text-zinc-500"}`}
                  >
                    📲 Pix
                  </button>
                  <button 
                    type="button" 
                    onClick={() => setPagamento("Dinheiro")}
                    className={`p-3 rounded-xl border font-black text-center uppercase tracking-wider transition-all ${pagamento === "Dinheiro" ? "bg-amber-500/10 border-amber-500 text-amber-400" : "bg-zinc-950 border-zinc-800 text-zinc-500"}`}
                  >
                    💵 Dinheiro
                  </button>
                </div>
              </div>

              {pagamento === "Dinheiro" && (
                <div className="space-y-1.5 pt-1 animate-fade-in">
                  <label className="text-[10px] font-bold text-amber-400 uppercase block">Precisa de troco para quanto?</label>
                  <input 
                    type="text" 
                    placeholder="Ex: 50.00" 
                    value={trocoPara} 
                    onChange={(e) => setTrocoPara(e.target.value)} 
                    className="w-full bg-zinc-950 border border-zinc-800 focus:border-amber-500 rounded-xl p-3 text-white outline-none font-medium" 
                  />
                  {trocoCalculado > 0 && (
                    <p className="text-[11px] text-emerald-400 font-bold">Seu troco será de: R$ {trocoCalculado.toFixed(2)}</p>
                  )}
                </div>
              )}
            </div>

            <div className="bg-zinc-900 border border-zinc-800 p-4 rounded-3xl space-y-2">
              <span className="text-[9px] uppercase tracking-widest text-zinc-500 font-black block border-b border-zinc-800 pb-1">Balanço do Pedido</span>
              <div className="flex justify-between text-zinc-400 font-medium"><span>Itens selecionados:</span><span>{totalItensSelecionados}x</span></div>
              {descontoCombo > 0 && (
                <div className="flex justify-between text-emerald-400 font-bold"><span>Desconto de Combo:</span><span>- R$ {descontoCombo.toFixed(2)}</span></div>
              )}
              <div className="flex justify-between items-center text-white font-black pt-1.5 border-t border-zinc-800">
                <span className="text-zinc-300">VALOR LÍQUIDO A PAGAR:</span>
                <span className="text-base text-emerald-400">R$ {valorTotalFinal.toFixed(2)}</span>
              </div>
            </div>

            <button 
              type="submit" 
              disabled={enviandoPedido || !lojaAberta || valorTotalFinal === 0}
              className="w-full py-4 bg-gradient-to-r from-orange-500 to-amber-500 disabled:opacity-30 disabled:pointer-events-none text-white text-xs font-black uppercase tracking-widest rounded-2xl transition-all shadow-lg shadow-orange-500/10 active:scale-95"
            >
              {enviandoPedido ? "Processando e Enviando..." : "Enviar Pedido para Cozinha ✓"}
            </button>
          </form>
        </div>
      )}

      {totalItensSelecionados > 0 && (
        <div className="fixed bottom-6 left-4 right-4 z-40 max-w-xl mx-auto animate-slide-up">
          <div className="bg-zinc-900/75 backdrop-blur-xl border border-white/5 rounded-3xl p-4 flex items-center justify-between shadow-2xl shadow-black/80">
            <div className="space-y-0.5">
              <span className="bg-orange-500/20 text-orange-400 font-black text-[10px] px-2 py-0.5 rounded-md uppercase tracking-wider">
                {totalItensSelecionados} {totalItensSelecionados === 1 ? "Item" : "Itens"}
              </span>
              <div className="flex items-baseline gap-1.5">
                <span className="text-xs text-zinc-400 font-medium">Total:</span>
                <span className="text-lg font-black text-emerald-400 tracking-tight">R$ {valorTotalFinal.toFixed(2)}</span>
              </div>
            </div>

            {etapa === "menu" ? (
              <button 
                type="button" 
                onClick={() => setEtapa("checkout")}
                className="bg-white text-zinc-950 text-xs font-black uppercase tracking-widest px-6 py-3.5 rounded-2xl shadow-lg transition-all hover:bg-zinc-100 active:scale-95"
              >
                Avançar →
              </button>
            ) : (
              <button 
                type="button" 
                onClick={() => setEtapa("menu")}
                className="bg-zinc-800 text-zinc-300 text-xs font-black uppercase tracking-wide px-5 py-3.5 rounded-2xl transition-all active:scale-95"
              >
                Cardápio
              </button>
            )}
          </div>
        </div>
      )}

    </main>
  )
}